verbosity=0;

// Nom du calcul
string Name="Nanoparticule3";

// =====================================================================
// PARTIE I — eCOULEMENT FLUIDE (STOKES)
// =====================================================================

///////////////////////////////// FLUIDE /////////////////////////////////////////
real Vc=1;        // m/sec
real Lc=1e-09;    // m
real etac=0.001;  // Pa.s   viscosite dynamique de l'eau
real rhoc=1000;   // Kg/m^3 eau
real Pc=10^6;     // Pa     1 MPa pour eau
real Re=rhoc*Lc*Vc/etac;
cout<<"Re="<<Re<<endl;
real eta=1.*etac*Vc/(Lc*Pc); // viscosite adimensionnee
cout<<"eta="<<eta<<endl;

// =====================================================================
// CONSTRUCTION DU DOMAINE
// =====================================================================
real e=5., a=2*e, dl=a, d=2*e;
real xA=0., yA=0., xD=0, yD=5*e, eTiO2=1.5*e;
real xL=0., yL=yD+eTiO2, xN=0, yN=6*e+yL;
real xK=dl,    yK=yL;
real xJ=xK+2*a, yJ=yL;
real xI=xJ+2*dl,yI=yK;
real xH=xI+2*a, yH=yK;
real xG=xH+2*dl,yG=yK;
real xF=xG+2*a, yF=yL;
real xE=xF+dl,  yE=yL;
real xM=xE,     yM=yN;
real xC=xE,     yC=yD;
real xB=xE,     yB=0.;

// ---------------- Bords du DOMAINE FLUIDE ---------------------------
border SEM(t=0,1){ x=xE+t*(xM-xE); y=yE+t*(yM-yE); label=2; } // sortie (droite)
border SMN(t=0,1){ x=xM+t*(xN-xM); y=yM+t*(yN-yM); label=3; } // haut
border SNL(t=0,1){ x=xN+t*(xL-xN); y=yN+t*(yL-yN); label=4; } // entree (gauche)
border SLK(t=0,1){ x=xL+t*(xK-xL); y=yL+t*(yK-yL); label=1; } // paroi inf.
border SKJ(t=pi,0.){ x=xK+a+a*cos(t); y=yL+d*sin(t); label=5; } // NANO 1
border SJI(t=0,1){ x=xJ+t*(xI-xJ); y=yJ+t*(yI-yJ); label=1; } // paroi inf.
border SIH(t=pi,0.){ x=xI+a+a*cos(t); y=yL+d*sin(t); label=6; } // NANO 2
border SHG(t=0,1){ x=xH+t*(xG-xH); y=yH+t*(yG-yH); label=1; } // paroi inf.
border SGF(t=pi,0.){ x=xG+a+a*cos(t); y=yE+d*sin(t); label=7; } // NANO 3
border SFE(t=0,1){ x=xF+t*(xE-xF); y=yF+t*(yE-yF); label=1; } // paroi inf.

// =====================================================================
// MAILLAGE FLUIDE
// =====================================================================
int me=5, mv=6*me, mh=me*xM/e, mdl=3*me*dl/e, Melip=3*8*me, mv1=5*me, mv2=1.5*me;

real H=0.001/Lc;                    // distance entre deux plaques
real LFiltre=0.08/Lc;               // longueur des plaques
real PDif=0.017*10^6/Pc;            // difference de pression entree/sortie
real C=-PDif/LFiltre;               // chute lineique de pression
real PEntry=0.5*PDif;               // surpression à l'entree
real DeltaP=-C*xE;                  // chute de pression dans la cellule

// Profil de vitesse de Poiseuille entre deux plaques
func real VV(real yy) { return C*(yy-H)*yy/(2*eta); }
real V=VV(yM-yL);                   // vitesse au sommet de la cellule
cout<<"V="<<V<<endl;

real eps=1e-13;

//plot(SFE(mdl)+SGF(Melip)+SHG(2*mdl)+SIH(Melip)+SJI(2*mdl)
//    +SKJ(Melip)+SLK(mdl)+SNL(mv)+SMN(mh)+SEM(mv));

mesh ThF = buildmesh(
      SFE(mdl)+SGF(Melip)+SHG(2*mdl)+SIH(Melip)+SJI(2*mdl)
    + SKJ(Melip)+SLK(mdl)+SNL(mv)+SMN(mh)+SEM(mv) );
plot(ThF,  wait=false,ps="maillagefluid.eps", cmm="Maillage fluide initial");

// Metrique pour le raffinement
func real Dist(real xx, real yy) {
    if(xx<=xK) return yy-yL;
    if ((xx>xK)&&(xx<xJ))  return yy-(yL+e*sqrt(1-((xx-xK-a)/a)^2));
    if((xx>=xJ)&&(xx<=xI)) return yy-yL;
    if((xx>xI)&&(xx<xH))   return yy-(yL+e*sqrt(1-((xx-xI-a)/a)^2));
    if((xx>=xH)&&(xx<=xG)) return yy-yL;
    if((xx>xG)&&(xx<xF))   return yy-(yL+e*sqrt(1-((xx-xG-a)/a)^2));
    return yy-yL;
}

fespace VhF(ThF,P2);
VhF fhF=Dist(x,y)/(5*e), Smesh;
real hminF=0.5*dl/mdl, hmaxF=20*hminF;
Smesh = hmaxF*fhF + hminF*(1-fhF);
cout<<hminF<<" "<<hmaxF<<" "<<Smesh[].min<<" "<<Smesh[].max<<endl;
plot(ThF, Smesh,  wait=false, ps="FluidMeshMetric.eps");

mesh Th = adaptmesh(ThF, Smesh, hmin=hminF, hmax=hmaxF,
                    IsMetric=1, err=0.01, nbvx=100000);
plot(Th,  wait=false, ps="FluidMeshRefined.eps");

// =====================================================================
// PARAMÈTRES PHYSIQUES FLUIDE
// =====================================================================
real nu = eta;
func fx = 0.0;
func fy = 0.0;

// =====================================================================
// ESPACES EF — Taylor-Hood P2-P1
// =====================================================================
fespace Vh(Th, P2);
fespace Qh(Th, P1);

Vh ux, uy;
Vh vx, vy;
Qh p;
Qh q;

// =====================================================================
// FORMULATION VARIATIONNELLE DE STOKES
// =====================================================================
problem Stokes([ux, uy, p], [vx, vy, q], solver=UMFPACK) =
    int2d(Th)(
        nu*( dx(ux)*dx(vx) + dy(ux)*dy(vx)
           + dx(uy)*dx(vy) + dy(uy)*dy(vy) )
      - p*(dx(vx) + dy(vy))
      - q*(dx(ux) + dy(uy))
      - 1.e-10*p*q
    )
  - int2d(Th)( fx*vx + fy*vy )
  - int1d(Th,4)(-PEntry*(vx*N.x + vy*N.y))
  - int1d(Th,2)((-PEntry + DeltaP)*(vx*N.x + vy*N.y))
  + on(1, ux=0., uy=0.)
  + on(5, ux=0., uy=0.)
  + on(6, ux=0., uy=0.)
  + on(7, ux=0., uy=0.)
  + on(4, uy=0.)
  + on(3, ux=V, uy=0.)
  + on(2, uy=0.);

Stokes;

// =====================================================================
// CALCUL DES EFFORTS SUR LES NANOPARTICULES (FLUIDE → SOLIDE)
// sigmaf = -p I + 2 eta D(u),   T = sigmaf . n
// =====================================================================
cout.precision(12);

macro Tx() ( -p*N.x + 2*nu*( dx(ux)*N.x + 0.5*(dy(ux)+dx(uy))*N.y ) ) //
macro Ty() ( -p*N.y + 2*nu*( 0.5*(dy(ux)+dx(uy))*N.x + dy(uy)*N.y ) ) //

real FDtot = int1d(Th, 5, 6, 7)( Tx );
real FLtot = int1d(Th, 5, 6, 7)( Ty );

real FD1 = int1d(Th, 5)( Tx ),  FL1 = int1d(Th, 5)( Ty );
real FD2 = int1d(Th, 6)( Tx ),  FL2 = int1d(Th, 6)( Ty );
real FD3 = int1d(Th, 7)( Tx ),  FL3 = int1d(Th, 7)( Ty );

cout << "=============================================" << endl;
cout << " Forces hydrodynamiques (adimensionnees)      " << endl;
cout << "---------------------------------------------" << endl;
cout << " Nanoparticule 1 : FD = " << FD1 << "  FL = " << FL1 << endl;
cout << " Nanoparticule 2 : FD = " << FD2 << "  FL = " << FL2 << endl;
cout << " Nanoparticule 3 : FD = " << FD3 << "  FL = " << FL3 << endl;
cout << "---------------------------------------------" << endl;
cout << " Total           : FD = " << FDtot << "  FL = " << FLtot << endl;
cout << "=============================================" << endl;

real divU = sqrt( int2d(Th)( (dx(ux)+dy(uy))^2 ) );
cout << "||div(u)||L2 = " << divU << endl;

// =====================================================================
// POST-TRAITEMENT FLUIDE
// =====================================================================
plot(p,   value=true,  wait=false, cmm="Pression p", ps="FluidPressure.eps");
plot([ux,uy],   value=true,  wait=false, cmm="Champ de vitesse [ux,uy]", ps="FluidVelocity.eps");
plot(p, [ux,uy], value=true,  wait=false, cmm="Stokes - Nanoparticules", ps="StokesCombined.eps");

// Contraintes fluide
real muf = nu;
fespace Wh(Th,P1dc);

Wh sxx = -p + 2*muf*dx(ux);
Wh syy = -p + 2*muf*dy(uy);
Wh sxy =       muf*(dy(ux) + dx(uy));

Wh vonMises = sqrt( sxx^2 + syy^2 - sxx*syy + 3*sxy^2 );
cout << "Contrainte max fluide (von Mises) = " << vonMises[].max << endl;

// =====================================================================
// EXPORT VTK FLUIDE — MAILLAGE
// =====================================================================
fespace Rh(Th,P1dc);
Rh Xdes=x, Ydes=y, Zdes=0, devdes;
int id;

{
    ofstream par("Maillage."+Name+".vtk");
    par <<"# vtk DataFile Version 1.0"<<endl;
    par <<"2D Fluid Mesh"<<endl;
    par <<"ASCII"<<endl<<" "<<endl;
    par <<"DATASET UNSTRUCTUREDGRID"<<endl;
    par <<"POINTS "<<Rh.ndof<<" float"<<endl;
    for (id=0; id<Rh.ndof; id++)
        par<< Xdes[][id] <<" "<< Ydes[][id] <<" "<< Zdes[][id] <<endl;
    par <<"CELLS "<<Rh.nt<<" "<<(Rh.ndofK+1)*Rh.nt<<endl;
    for (id=0; id<Rh.nt; id++)
        par<<"3 "<<Rh(id,0)<<" "<<Rh(id,1)<<" "<<Rh(id,2)<<endl;
    par <<" "<<endl<<"CELL_TYPES "<<Rh.nt<<endl;
    for (id=0; id<Rh.nt; id++) par<<"5"<<endl;
}

// =====================================================================
// EXPORT VTK FLUIDE — ReSULTATS
// =====================================================================
{
    ofstream paru("ResultsFluid"+Name+".vtk");
    Rh velx = ux, vely = uy;
    Rh speed = sqrt(ux*ux + uy*uy);
    Rh vmF = vonMises;
    Rh pres2 = p;

    paru <<"# vtk DataFile Version 1.0"<<endl;
    paru <<"Fluid Results Stokes"<<endl;
    paru <<"ASCII"<<endl<<" "<<endl;
    paru <<"DATASET UNSTRUCTUREDGRID"<<endl;
    paru <<"POINTS "<<Rh.ndof<<" float"<<endl;
    for (id=0; id<Rh.ndof; id++)
        paru<< Xdes[][id] <<" "<< Ydes[][id] <<" "<< Zdes[][id] <<endl;
    paru <<"CELLS "<<Rh.nt<<" "<<(Rh.ndofK+1)*Rh.nt<<endl;
    for (id=0; id<Rh.nt; id++)
        paru<<"3 "<<Rh(id,0)<<" "<<Rh(id,1)<<" "<<Rh(id,2)<<endl;
    paru <<" "<<endl<<"CELL_TYPES "<<Rh.nt<<endl;
    for (id=0; id<Rh.nt; id++) paru<<"5"<<endl;

    paru <<" "<<endl<<"POINT_DATA "<<Rh.ndof<<endl;
    paru <<"VECTORS velocity float"<<endl;
    for (id=0; id<Rh.ndof; id++)
        paru<< velx[][id] <<" "<< vely[][id] <<" 0"<<endl;
    paru <<"SCALARS speed float"<<endl<<"LOOKUPTABLE default"<<endl;
    for (id=0; id<Rh.ndof; id++) paru<< speed[][id] <<endl;
    paru <<"SCALARS vonMisesfluid float"<<endl<<"LOOKUPTABLE default"<<endl;
    for (id=0; id<Rh.ndof; id++) paru<< vmF[][id] <<endl;
    paru <<"SCALARS pressure float"<<endl<<"LOOKUPTABLE default"<<endl;
    for (id=0; id<Rh.ndof; id++) paru<< pres2[][id] <<endl;
}
cout << endl;
cout << "=====================================================" << endl;
cout << " PARTIE II - DEFORMATION SOLIDE (ELASTICITE + NEWTON)" << endl;
cout << "=====================================================" << endl;

// =====================================================================
// PARAMÈTRES MATeRIAU — Argent (Ag), adimensionnes avec Pc=1 MPa, Lc=1nm
// EAg ~ 83 GPa  => E* = E/Pc = 83e9/1e6 = 83000
// nuAg ~ 0.37
// =====================================================================
real Enano  = 83000.;
real nunano = 0.37;
real lambda = Enano*nunano / ((1.+nunano)*(1.-2.*nunano));
real mus    = Enano / (2.*(1.+nunano));
cout << "lambda = " << lambda << "  mu = " << mus << endl;

// =====================================================================
// PARAMÈTRES LENNARD-JONES (adimensionnes)
// deq : distance d'equilibre LJ (adim.) = 0.2 nm / Lc
// h0  : distance initiale particule-substrat (adim.) = 2 nm / Lc
//       h0 >> deq => force initiale attractive faible, stable
// epsLJ : energie d'adhesion adimensionnee par Pc*Lc^2
// =====================================================================
real epsLJ = 1.e-3;
real deq   = 0.2;    // distance d'equilibre LJ (adim.)
real h0    = 2.0;    // distance initiale particule-substrat (adim.)

// =====================================================================
// PARAMÈTRES DE FROTTEMENT DE COULOMB
// =====================================================================
real muFric = 0.3;
real epsReg = 1.e-8;

// =====================================================================
// PeNALISATION DE CONTACT (evite la penetration h < hmin)
// =====================================================================
real Kpenalty  = 1.e4 * mus;   // rigidite de penalite
real hmincont = 0.05 * deq;   // seuil minimal de gap

// =====================================================================
// DOMAINE SOLIDE — nanoparticule 2 (centrale, label 6 dans le fluide)
// Semi-ellipse : demi-axes aS (horizontal), dS (vertical)
// Base à y = yL, centre en (xI+a, yL)
// label 10 = Gammawall (base, interface substrat)
// label 11 = Gammafluid (demi-ellipse, surface fluide)
// =====================================================================
real xC2 = xI + a;
real yC2 = yL;
real aS  = a;
real dS  = d;

int nEllip = 60;
int nBase  = 30;

border BbaseP(t=0,1){
    x = (xC2+aS) + t*((xC2-aS)-(xC2+aS));
    y = yC2;
    label=10;
}
border BellipP(t=0,pi){
    x = xC2 + aS*cos(t);
    y = yC2 + dS*sin(t);
    label=11;
}

mesh ThS = buildmesh( BbaseP(-nBase) + BellipP(nEllip) );
plot(ThS, wait=false, cmm="Maillage solide initial", ps="SolidMeshInitial.eps");

// Raffinement adaptatif près de la base
fespace VhSinit(ThS, P2);
VhSinit distS = (y - yC2) / dS;
real hminS = 0.3*dS/nEllip, hmaxS = 8.*hminS;
VhSinit SmeshS = hmaxS*distS + hminS*(1.-distS);
mesh ThSA = adaptmesh(ThS, SmeshS, hmin=hminS, hmax=hmaxS,
                      IsMetric=1, err=0.01, nbvx=50000);
plot(ThSA, wait=false, cmm="Maillage solide raffine", ps="SolidMeshRefined.eps");

// Export VTK maillage solide
fespace R2h(ThSA, P1dc);
R2h X2des=x, Y2des=y, Z2des=0;
int id2;
{
    ofstream par("Maillage2."+Name+".vtk");
    par <<"# vtk DataFile Version 1.0"<<endl;
    par <<"2D Solid Mesh"<<endl;
    par <<"ASCII"<<endl<<" "<<endl;
    par <<"DATASET UNSTRUCTUREDGRID"<<endl;
    par <<"POINTS "<<R2h.ndof<<" float"<<endl;
    for(id2=0; id2<R2h.ndof; id2++)
        par<< X2des[][id2] <<" "<< Y2des[][id2] <<" "<< Z2des[][id2] <<endl;
    par <<"CELLS "<<R2h.nt<<" "<<(R2h.ndofK+1)*R2h.nt<<endl;
    for(id2=0; id2<R2h.nt; id2++)
        par<<"3 "<<R2h(id2,0)<<" "<<R2h(id2,1)<<" "<<R2h(id2,2)<<endl;
    par <<" "<<endl<<"CELL_TYPES "<<R2h.nt<<endl;
    for(id2=0; id2<R2h.nt; id2++) par<<"5"<<endl;
}

// =====================================================================
// ESPACES EF SOLIDE — P2 pour les deplacements
// =====================================================================
fespace Ws(ThSA, P2);
Ws u1, u2;
Ws Dux, Duy;
Ws Duxo, Duyo;
Ws uSx, uSy;
Ws S;
Ws v1, v2;

// =====================================================================
// INTERPOLATION DE LA TRACTION FLUIDE SUR LE MAILLAGE SOLIDE
// Projection des contraintes fluide (depuis ThF) vers ThSA
// =====================================================================
fespace WsP1(ThSA, P1dc);
WsP1 SxxF, SyyF, SxyF;
SxxF = -p(x,y) + 2.*nu*dx(ux)(x,y);
SyyF = -p(x,y) + 2.*nu*dy(uy)(x,y);
SxyF =  nu*(dy(ux)(x,y) + dx(uy)(x,y));

real coupling = 1.0;

// =====================================================================
// MACROS eLASTICITe
// =====================================================================
macro Div(w1,w2)         (dx(w1)+dy(w2))                              // EOM
macro Epseps(u1,u2,v1,v2)( dx(u1)*dx(v1) + dy(u2)*dy(v2)
                          + 0.5*(dy(u1)+dx(u2))*(dy(v1)+dx(v2)) )    // EOM
macro Abilin(u1,u2,v1,v2)( lambda*Div(u1,u2)*Div(v1,v2)
                          + 2.*mus*Epseps(u1,u2,v1,v2) )              // EOM

// =====================================================================
// MACROS LENNARD-JONES
// Convention : sur Gammawall (label 10), next = (0,-1)
//   => un = u.n = -u2  (deplacement normal sortant)
//   => gap h = h0 + u2  (h diminue quand u2 < 0, i.e. particule descend)
//
// Potentiel LJ : E(h) = epsLJ * [(deq/h)^12 - 2*(deq/h)^6]
// Force (dans +y, vers l'interieur) : FLJ = -dE/dh
//   = 12*epsLJ/deq * [(deq/h)^13 - (deq/h)^7]
//   > 0 si h < deq (repulsion), < 0 si h > deq (attraction)
// Rigidite tangente : kappa = d²E/dh²
//   = 12*epsLJ/deq² * [13*(deq/h)^14 - 7*(deq/h)^8]
// =====================================================================
macro gapLJ(u2)   max(h0 + u2, 1.e-12)                               // EOM
macro FLJmac(u2)  ( 12.*epsLJ/deq*( (deq/gapLJ(u2))^13
                                   -(deq/gapLJ(u2))^7 ) )            // EOM
macro kapLJ(u2)   ( 12.*epsLJ/(deq*deq)*( 13.*(deq/gapLJ(u2))^14
                                         - 7.*(deq/gapLJ(u2))^8 ) ) // EOM

// =====================================================================
// MACROS FROTTEMENT DE COULOMB (regularise)
// ut = u1 (tangentielle sur label 10, t = (1,0))
// Ffr = -muFric * max(FLJ, 0) * u1/|u1|reg
// Kt   = derivee de Ffr par rapport à u1 (pour le jacobien Newton)
// =====================================================================
macro uTnorm(u1)      sqrt(u1*u1 + epsReg*epsReg)                    // EOM
macro FricForce(u1,u2)( -muFric*max(FLJmac(u2),0.)*u1/uTnorm(u1) )  // EOM
macro Kt(u1,u2)       ( muFric*max(FLJmac(u2),0.)*epsReg^2
                        /uTnorm(u1)^3 )                               // EOM

// =====================================================================
// MACRO PeNALISATION DE CONTACT UNILATeRAL
// Empêche h < hmincont en ajoutant une rigidite de penalite
// Active seulement si gapLJ(u2) < hmincont
// =====================================================================
macro penContact(u2) ( Kpenalty*(gapLJ(u2) < hmincont ? 1. : 0.) )  // EOM

// Fonction scalaire utilitaire (regularisation Coulomb)
func real Qpd(real xx) {
    return epsReg^2 / pow(xx*xx + epsReg^2, 3./2.);
}

// =====================================================================
// INITIALISATION
// =====================================================================
u1 = 0.; u2 = 0.;
Dux = 0.; Duy = 0.;
Duxo = 0.; Duyo = 0.;
uSx = 0.; uSy = 0.;

int NmaxNewton = 80;
real tolerence = 1.e-6;

// Verification initiale des ordres de grandeur
real FLJ0   = int1d(ThSA, 10)( FLJmac(0.) );
real Ffluid0= int1d(ThSA, 11)( (SxyF*N.x + SyyF*N.y) );
cout << "=== Verification initiale ===" << endl;
cout << "  FLJ(h0)   = " << FLJ0    << "  (attraction si < 0)" << endl;
cout << "  Ffluidey = " << Ffluid0 << endl;
cout << "  gap initial = " << h0 << " >> deq = " << deq << endl;
cout << "==============================" << endl;

// =====================================================================
// BOUCLE DE NEWTON
// =====================================================================
for(int Nw=0; Nw<NmaxNewton; Nw++) {
    Duxo = Dux;
    Duyo = Duy;

    // Partie compressive de la contrainte normale (proxy pour Coulomb)
    // sigma22 = lambda*div(u) + 2*mu*du2/dy  sur la base
    // S = [sigma22]-  = partie negative (compression)
    S = 0.5*( abs(lambda*Div(Dux,Duy) + 2.*mus*dy(Duy))
             -(    lambda*Div(Dux,Duy) + 2.*mus*dy(Duy)) );

    problem Plan([uSx,uSy],[v1,v2], solver=UMFPACK) =

        // ── Jacobien elastique ─────────────────────────────────────
        int2d(ThSA)( Abilin(uSx,uSy,v1,v2) )

        // ── Rigidite tangente LJ ───────────────────────────────────
        // Contribution du jacobien de FLJ : -dFLJ/dh * dh/du2 * δu2 * v2
        // dh/du2 = 1,  signe : FLJ est dans +y => - kapLJ * δu2 * v2
        - int1d(ThSA, 10)( kapLJ(Duy) * uSy * v2 )

        // ── Rigidite tangente penalisation contact ─────────────────
        // Bloque u2 si h < hmincont
        + int1d(ThSA, 10)( penContact(Duy) * uSy * v2 )

        // ── Rigidite tangente Coulomb ──────────────────────────────
        + int1d(ThSA, 10)( Kt(Dux,Duy) * uSx * v1 )

        // ── Residu elastique (RHS negatif du residu) ──────────────
        + int2d(ThSA)( Abilin(Dux,Duy,v1,v2) )

        // ── Chargement fluide sur Gammafluid (label 11) ──────────
        + int1d(ThSA, 11)(
             coupling*( (SxxF*N.x + SxyF*N.y)*v1
                      + (SxyF*N.x + SyyF*N.y)*v2 )
        )

        // ── Chargement LJ sur Gammawall (label 10) ───────────────
        // FLJ dans +y => -FLJ*v2 dans le residu (côte RHS)
        - int1d(ThSA, 10)( FLJmac(Duy) * v2 )

        // ── Residu penalisation contact (RHS) ─────────────────────
        // Force de rappel si h < hmincont : pousse vers h = hmincont
        + int1d(ThSA, 10)(
             penContact(Duy) * (gapLJ(Duy) - hmincont) * v2
        )

        // ── Residu frottement Coulomb (RHS) ───────────────────────
        - int1d(ThSA, 10)( FricForce(Dux,Duy) * v1 );

    Plan;

    // ── Line search : contrainte sur le gap ET sur FLJ ────────────
    real omega = 1.0;
    real gapMin;
    real FLJold = int1d(ThSA, 10)( FLJmac(Duyo) );

    for(int ls=0; ls<16; ls++){
        Dux = Duxo + omega*uSx;
        Duy = Duyo + omega*uSy;
        gapMin = h0 + Duy[].min;
        real FLJnew = int1d(ThSA, 10)( FLJmac(Duy) );
        // Accepter si : gap suffisant ET FLJ ne multiplie pas par plus de 100
        if( gapMin > hmincont
         && FLJnew < 100.*max(abs(FLJold), abs(FLJ0)+1.) ) break;
        omega *= 0.5;
    }

    real error  = sqrt( int2d(ThSA)( uSx^2 + uSy^2 ) / int2d(ThSA)(1.) );
    real FLJnow = int1d(ThSA, 10)( FLJmac(Duy) );
    real gapNow = h0 + Duy[].min;
    cout << "Nw=" << Nw
         << " omega=" << omega
         << " error=" << error
         << " gap=" << gapNow
         << " FLJ=" << FLJnow << endl;

    if(error < tolerence) {
        cout << "==> Convergence Newton atteinte en " << Nw+1
             << " iterations" << endl;
        break;
    }
}

u1 = Dux;
u2 = Duy;

// =====================================================================
// POST-TRAITEMENT SOLIDE
// =====================================================================
fespace PhS(ThSA, P1);
PhS s11, s22, s12, vmSolid;

s11 = lambda*Div(u1,u2) + 2.*mus*dx(u1);
s22 = lambda*Div(u1,u2) + 2.*mus*dy(u2);
s12 = mus*(dy(u1) + dx(u2));
vmSolid = sqrt( s11^2 - s11*s22 + s22^2 + 3.*s12^2 );

cout << endl;
cout << "=============================================" << endl;
cout << " Resultats solide (adimensionnes)            " << endl;
cout << "---------------------------------------------" << endl;
cout << " ||u||inf    = " << sqrt(u1[].linfty^2+u2[].linfty^2) << endl;
cout << " sigmaVM max = " << vmSolid[].max << endl;
cout << "=============================================" << endl;

// Bilan des forces
real FfluidX = int1d(ThSA, 11)( (SxxF*N.x + SxyF*N.y) );
real FfluidY = int1d(ThSA, 11)( (SxyF*N.x + SyyF*N.y) );
real FadhY   = int1d(ThSA, 10)( FLJmac(u2) );
real FfrotX  = int1d(ThSA, 10)( FricForce(u1,u2) );
real gapFinal= h0 + u2[].min;
cout << " Ffluidex    = " << FfluidX  << endl;
cout << " Ffluidey    = " << FfluidY  << endl;
cout << " Fadhy (LJ)  = " << FadhY   << endl;
cout << " Ffrotx (Cf) = " << FfrotX  << endl;
cout << " gap final    = " << gapFinal << "  (deq=" << deq << ")" << endl;

// Glissement tangentiel et norme deplacement
PhS glissement = u1;
PhS deplNorm   = sqrt(u1^2 + u2^2);

// =====================================================================
// VISUALISATION
// =====================================================================
plot(ThSA, [u1,u2], value=true, wait=false,
     cmm="Deplacement solide [u1,u2]", ps="SolidDisplacement.eps");
plot(ThSA, vmSolid, value=true, wait=false,
     cmm="Contrainte von Mises solide", ps="SolidVonMises.eps");
plot(ThSA, glissement, value=true, wait=false,
     cmm="Glissement tangentiel u1", ps="SolidSlip.eps");

real scaleP = min(0.20*dS / (u1[].linfty + u2[].linfty + 1.e-30), 1.e4);
cout << "Facteur amplification maillage deforme : x" << scaleP << endl;
mesh ThSdef = movemesh(ThSA, [x + scaleP*u1, y + scaleP*u2]);
plot(ThSdef, wait=false,
     cmm="Maillage deforme (x"+scaleP+")", ps="SolidDeformedMesh.eps");

// =====================================================================
// EXPORT VTK SOLIDE
// =====================================================================
{
    fespace RhS(ThSA, P1dc);
    RhS XdesS=x, YdesS=y, ZdesS=0;
    RhS u1des=u1, u2des=u2;
    RhS vmdes=vmSolid;
    RhS s11des=s11, s22des=s22, s12des=s12;
    RhS glisdes=glissement;
    RhS depldes=deplNorm;
    RhS gapdes = gapLJ(u2);

    // ── Maillage non deforme ──────────────────────────────────────
    {
        ofstream fvtk("ResultsSolid"+Name+".vtk");
        fvtk <<"# vtk DataFile Version 1.0"<<endl;
        fvtk <<"Solid Nanoparticle FSI Results"<<endl;
        fvtk <<"ASCII"<<endl<<" "<<endl;
        fvtk <<"DATASET UNSTRUCTUREDGRID"<<endl;
        fvtk <<"POINTS "<<RhS.ndof<<" float"<<endl;
        for(id=0; id<RhS.ndof; id++)
            fvtk<< XdesS[][id] <<" "<< YdesS[][id] <<" "<< ZdesS[][id] <<endl;
        fvtk<<"CELLS "<<RhS.nt<<" "<<(RhS.ndofK+1)*RhS.nt<<endl;
        for(id=0; id<RhS.nt; id++)
            fvtk<<"3 "<<RhS(id,0)<<" "<<RhS(id,1)<<" "<<RhS(id,2)<<endl;
        fvtk<<" "<<endl<<"CELL_TYPES "<<RhS.nt<<endl;
        for(id=0; id<RhS.nt; id++) fvtk<<"5"<<endl;
        fvtk<<" "<<endl<<"POINT_DATA "<<RhS.ndof<<endl;
        fvtk<<"VECTORS displacement float"<<endl;
        for(id=0; id<RhS.ndof; id++)
            fvtk<< u1des[][id] <<" "<< u2des[][id] <<" 0"<<endl;
        fvtk<<"SCALARS displacementnorm float"<<endl<<"LOOKUPTABLE default"<<endl;
        for(id=0; id<RhS.ndof; id++) fvtk<< depldes[][id] <<endl;
        fvtk<<"SCALARS vonMisessolid float"<<endl<<"LOOKUPTABLE default"<<endl;
        for(id=0; id<RhS.ndof; id++) fvtk<< vmdes[][id] <<endl;
        fvtk<<"SCALARS sigma11 float"<<endl<<"LOOKUPTABLE default"<<endl;
        for(id=0; id<RhS.ndof; id++) fvtk<< s11des[][id] <<endl;
        fvtk<<"SCALARS sigma22 float"<<endl<<"LOOKUPTABLE default"<<endl;
        for(id=0; id<RhS.ndof; id++) fvtk<< s22des[][id] <<endl;
        fvtk<<"SCALARS sigma12 float"<<endl<<"LOOKUPTABLE default"<<endl;
        for(id=0; id<RhS.ndof; id++) fvtk<< s12des[][id] <<endl;
        fvtk<<"SCALARS sliptangential float"<<endl<<"LOOKUPTABLE default"<<endl;
        for(id=0; id<RhS.ndof; id++) fvtk<< glisdes[][id] <<endl;
        fvtk<<"SCALARS gaph float"<<endl<<"LOOKUPTABLE default"<<endl;
        for(id=0; id<RhS.ndof; id++) fvtk<< gapdes[][id] <<endl;
    }

    // ── Maillage deforme ──────────────────────────────────────────
    {
        fespace RhSD(ThSdef, P1dc);
        RhSD XdesSD=x, YdesSD=y, ZdesSD=0;
        RhSD u1D=u1, u2D=u2;
        RhSD vmD=vmSolid;
        RhSD glisD=glissement;
        RhSD gapD=gapdes;
        RhSD s11D=s11, s22D=s22, s12D=s12;
        RhSD deplD=deplNorm;

        ofstream fvtkD("ResultsSolidDeformed"+Name+".vtk");
        fvtkD <<"# vtk DataFile Version 1.0"<<endl;
        fvtkD <<"Solid Nanoparticle DEFORMED Mesh"<<endl;
        fvtkD <<"ASCII"<<endl<<" "<<endl;
        fvtkD <<"DATASET UNSTRUCTUREDGRID"<<endl;
        fvtkD <<"POINTS "<<RhSD.ndof<<" float"<<endl;
        for(id=0; id<RhSD.ndof; id++)
            fvtkD<< XdesSD[][id] <<" "<< YdesSD[][id] <<" "<< ZdesSD[][id] <<endl;
        fvtkD<<"CELLS "<<RhSD.nt<<" "<<(RhSD.ndofK+1)*RhSD.nt<<endl;
        for(id=0; id<RhSD.nt; id++)
            fvtkD<<"3 "<<RhSD(id,0)<<" "<<RhSD(id,1)<<" "<<RhSD(id,2)<<endl;
        fvtkD<<" "<<endl<<"CELL_TYPES "<<RhSD.nt<<endl;
        for(id=0; id<RhSD.nt; id++) fvtkD<<"5"<<endl;
        fvtkD<<" "<<endl<<"POINT_DATA "<<RhSD.ndof<<endl;
        fvtkD<<"VECTORS displacement float"<<endl;
        for(id=0; id<RhSD.ndof; id++)
            fvtkD<< u1D[][id] <<" "<< u2D[][id] <<" 0"<<endl;
        fvtkD<<"SCALARS displacementnorm float"<<endl<<"LOOKUPTABLE default"<<endl;
        for(id=0; id<RhSD.ndof; id++) fvtkD<< deplD[][id] <<endl;
        fvtkD<<"SCALARS vonMisessolid float"<<endl<<"LOOKUPTABLE default"<<endl;
        for(id=0; id<RhSD.ndof; id++) fvtkD<< vmD[][id] <<endl;
        fvtkD<<"SCALARS sigma11 float"<<endl<<"LOOKUPTABLE default"<<endl;
        for(id=0; id<RhSD.ndof; id++) fvtkD<< s11D[][id] <<endl;
        fvtkD<<"SCALARS sigma22 float"<<endl<<"LOOKUPTABLE default"<<endl;
        for(id=0; id<RhSD.ndof; id++) fvtkD<< s22D[][id] <<endl;
        fvtkD<<"SCALARS sigma12 float"<<endl<<"LOOKUPTABLE default"<<endl;
        for(id=0; id<RhSD.ndof; id++) fvtkD<< s12D[][id] <<endl;
        fvtkD<<"SCALARS sliptangential float"<<endl<<"LOOKUPTABLE default"<<endl;
        for(id=0; id<RhSD.ndof; id++) fvtkD<< glisD[][id] <<endl;
        fvtkD<<"SCALARS gaph float"<<endl<<"LOOKUPTABLE default"<<endl;
        for(id=0; id<RhSD.ndof; id++) fvtkD<< gapD[][id] <<endl;
    }
}

// =====================================================================
// ReSUMe FINAL
// =====================================================================
cout << endl;
cout << "=====================================================" << endl;
cout << " FICHIERS VTK GENERES :" << endl;
cout << "  - Maillage."           << Name << ".vtk" << endl;
cout << "  - ResultsFluid"        << Name << ".vtk" << endl;
cout << "  - ResultsSolid"        << Name << ".vtk" << endl;
cout << "  - ResultsSolidDeformed"<< Name << ".vtk" << endl;
cout << "-----------------------------------------------------" << endl;
cout << " Scalaires : displacementnorm, vonMisessolid,"       << endl;
cout << "             sigma11/22/12, sliptangential, gaph"    << endl;
cout << " Vecteurs  : displacement, velocity"                   << endl;
cout << "=====================================================" << endl;