verbosity=0;

// =========================================================================
//  Nano6.edp
//  Stabilité mécanique des nanocomposites sous flux de fluide
//  Conforme à la formulation théorique du rapport (Partie I + Partie II)
//
//  Partie I  : Écoulement de Stokes stationnaire, Taylor-Hood P2-P1,
//              maillage adaptatif, calcul des tractions fluides sur Γ_part.
//
//  Partie II : Déformation non linéaire de la nanoparticule centrale (nano 2)
//              par la méthode de Newton.
//              Formulation variationnelle (éq. 27 du rapport) :
//                a(u, v-u) + j(u,v) - j(u,u) >= ℓ(v-u)
//              avec :
//                a(u,v)    = ∫_Ωs [λ div(u)div(v) + 2μ ε(u):ε(v)] dx
//                ℓ(v)      = ∫_ΓN T_fluide · v ds
//                j(u,v)    = ∫_Γf μf |[σn(u)]_-| |v_t| ds
//                            − ∫_ΓN F_adh(d(u)) v_n ds
//                            − ∫_Γf F_adh(d(u)) v_n ds
//              Lennard-Jones (éq. 16-17) sur Γ_N ∪ Γ_f.
//              Frottement de Coulomb régularisé (éq. 19) sur Γ_f.
//
//  Export VTK : fluide (vitesse, pression, von Mises) + solide
//               (déplacement, von Mises, glissement, gap LJ)
// =========================================================================

string Name = "Nano6";

// =========================================================================
// PARTIE I — ÉCOULEMENT DE STOKES
// =========================================================================

// ----- Paramètres physiques et adimensionnels -----
real Vc   = 1;       // vitesse de référence [m/s]
real Lc   = 1e-9;    // longueur de référence [m]
real etac = 0.001;   // viscosité dynamique eau [Pa·s]
real rhoc = 1000.;   // masse volumique eau [kg/m³]
real Pc   = 1e6;     // pression de référence [Pa]
real Re   = rhoc*Lc*Vc/etac;
real eta  = etac*Vc/(Lc*Pc);  // viscosité adimensionnée (= 1/Re normalisée sur Pc)
cout << "Re = " << Re << "  eta = " << eta << endl;

// ----- Géométrie du domaine fluide -----
real e  = 5.,  a  = 2*e,  dl = a,  d = 2*e;
real xA = 0.,  yA = 0.;
real xD = 0.,  yD = 5*e;
real eTiO2 = 1.5*e;
real xL = 0.,  yL = yD + eTiO2;     // ordonnée de la paroi inférieure (substrat)
real xN = 0.,  yN = 6*e + yL;       // ordonnée du haut du domaine
real xM = 0.,  yM = yN;

// Coordonnées des points-clés (paroi inférieure + nanoparticules)
real xK = dl,       yK = yL;
real xJ = xK+2*a,   yJ = yL;
real xI = xJ+2*dl,  yI = yK;
real xH = xI+2*a,   yH = yK;
real xG = xH+2*dl,  yG = yK;
real xF = xG+2*a,   yF = yL;
real xE = xF+dl,    yE = yL;
xM = xE;  yM = yN;

// ----- Frontières du domaine fluide -----
// label 1 = paroi inférieure (substrat TiO2 + entre nano), label 2 = sortie (droite)
// label 3 = haut (canal),     label 4 = entrée (gauche)
// label 5,6,7 = surface des 3 nanoparticules
border SEM(t=0,1){ x=xE+t*(xM-xE); y=yE+t*(yM-yE); label=2; }  // sortie
border SMN(t=0,1){ x=xM+t*(xN-xM); y=yM+t*(yN-yM); label=3; }  // haut
border SNL(t=0,1){ x=xN+t*(xL-xN); y=yN+t*(yL-yN); label=4; }  // entrée
border SLK(t=0,1){ x=xL+t*(xK-xL); y=yL+t*(yK-yL); label=1; }  // paroi inf.
border SKJ(t=pi,0.){ x=xK+a+a*cos(t); y=yL+d*sin(t); label=5; } // nano 1
border SJI(t=0,1){ x=xJ+t*(xI-xJ); y=yJ+t*(yI-yJ); label=1; }  // paroi inf.
border SIH(t=pi,0.){ x=xI+a+a*cos(t); y=yL+d*sin(t); label=6; } // nano 2
border SHG(t=0,1){ x=xH+t*(xG-xH); y=yH+t*(yG-yH); label=1; }  // paroi inf.
border SGF(t=pi,0.){ x=xG+a+a*cos(t); y=yE+d*sin(t); label=7; } // nano 3
border SFE(t=0,1){ x=xF+t*(xE-xF); y=yF+t*(yE-yF); label=1; }  // paroi inf.

// ----- Discrétisation des bords -----
int me=5, mv=6*me, mh=me*xM/e, mdl=3*me*dl/e, Melip=3*8*me;

// ----- Profil de Poiseuille (conditions aux limites) -----
real H       = 0.001/Lc;         // distance entre plaques
real LFiltre = 0.08/Lc;          // longueur des plaques
real PDif    = 0.017e6/Pc;       // différence de pression entrée/sortie (adim.)
real C       = -PDif/LFiltre;    // chute linéique de pression
real PEntry  = 0.5*PDif;         // surpression à l'entrée
real DeltaP  = -C*xE;            // chute de pression dans la cellule
func real VV(real yy){ return C*(yy-H)*yy/(2.*eta); }
real V = VV(yM-yL);              // vitesse imposée en haut (label 3)
cout << "V_canal = " << V << endl;

// ----- Maillage fluide initial -----
mesh ThF = buildmesh(
      SFE(mdl)+SGF(Melip)+SHG(2*mdl)+SIH(Melip)+SJI(2*mdl)
    + SKJ(Melip)+SLK(mdl)+SNL(mv)+SMN(mh)+SEM(mv));
plot(ThF, wait=false, cmm="Maillage fluide initial", ps="F_mesh_initial.eps");

// ----- Métrique de raffinement (distance à la paroi inférieure) -----
func real Dist(real xx, real yy){
    if(xx<=xK) return yy-yL;
    if((xx>xK)&&(xx<xJ))  return yy-(yL+e*sqrt(1-((xx-xK-a)/a)^2));
    if((xx>=xJ)&&(xx<=xI)) return yy-yL;
    if((xx>xI)&&(xx<xH))  return yy-(yL+e*sqrt(1-((xx-xI-a)/a)^2));
    if((xx>=xH)&&(xx<=xG)) return yy-yL;
    if((xx>xG)&&(xx<xF))  return yy-(yL+e*sqrt(1-((xx-xG-a)/a)^2));
    return yy-yL;
}
fespace VhF(ThF,P2);
VhF fhF=Dist(x,y)/(5.*e), Smesh;
real hminF=0.5*dl/mdl, hmaxF=20.*hminF;
Smesh = hmaxF*fhF + hminF*(1.-fhF);

// ----- Maillage adaptatif fluide -----
mesh Th = adaptmesh(ThF, Smesh, hmin=hminF, hmax=hmaxF,
                    IsMetric=1, err=0.01, nbvx=100000);
plot(Th, wait=false, cmm="Maillage fluide adapte", ps="F_mesh_refined.eps");
cout << "Maillage fluide : " << Th.nt << " triangles" << endl;

// =========================================================================
// RÉSOLUTION STOKES — Taylor-Hood P2-P1
// Satisfait la condition inf-sup de Babuška-Brezzi (βh > 0 indép. de h)
// =========================================================================
real nu = eta;   // viscosité adimensionnée

fespace Vh(Th,P2);   Vh ux,uy,vx,vy;
fespace Qh(Th,P1);   Qh p,q;

problem Stokes([ux,uy,p],[vx,vy,q], solver=UMFPACK) =
    int2d(Th)(
        // a(u,v) = ν ∫ ∇u:∇v
        nu*( dx(ux)*dx(vx)+dy(ux)*dy(vx)
            +dx(uy)*dx(vy)+dy(uy)*dy(vy) )
        // b(v,p) = −∫ p div(v)
        - p*(dx(vx)+dy(vy))
        // b(u,q) = −∫ q div(u)
        - q*(dx(ux)+dy(uy))
        // Stabilisation pression (faible, assure unicité)
        - 1.e-10*p*q
    )
    // Second membre volumique f=0
    - int2d(Th)(0.*vx+0.*vy)
    // Conditions de Neumann sur pression (entrée/sortie)
    - int1d(Th,4)( -PEntry*(vx*N.x+vy*N.y) )
    - int1d(Th,2)( (-PEntry+DeltaP)*(vx*N.x+vy*N.y) )
    // Dirichlet : adhérence sur parois et nanoparticules
    + on(1, ux=0., uy=0.)
    + on(5, ux=0., uy=0.)
    + on(6, ux=0., uy=0.)
    + on(7, ux=0., uy=0.)
    // Dirichlet partiel : vitesse tangentielle imposée sur entrée/sortie/haut
    + on(4, uy=0.)
    + on(3, ux=V, uy=0.)
    + on(2, uy=0.);

Stokes;
cout << "Stokes resolu." << endl;

// =========================================================================
// CALCUL DES EFFORTS HYDRODYNAMIQUES — T = σ(u,p)·n sur Γ_part
// σ(u,p) = −p I + 2η D(u),  D(u) = ½(∇u + ∇u^T)
// =========================================================================
cout.precision(12);

// Traction fluide sur chaque nanoparticule
macro TxF() (-p*N.x + 2.*nu*(dx(ux)*N.x + 0.5*(dy(ux)+dx(uy))*N.y)) //
macro TyF() (-p*N.y + 2.*nu*(0.5*(dy(ux)+dx(uy))*N.x + dy(uy)*N.y)) //

real FD1=int1d(Th,5)(TxF), FL1=int1d(Th,5)(TyF);
real FD2=int1d(Th,6)(TxF), FL2=int1d(Th,6)(TyF);
real FD3=int1d(Th,7)(TxF), FL3=int1d(Th,7)(TyF);
real FDtot=FD1+FD2+FD3,    FLtot=FL1+FL2+FL3;

cout << "=====================================================" << endl;
cout << " Forces hydrodynamiques (adimensionnees)" << endl;
cout << "-----------------------------------------------------" << endl;
cout << " Nano 1 : FD = " << FD1 << "  FL = " << FL1 << endl;
cout << " Nano 2 : FD = " << FD2 << "  FL = " << FL2 << endl;
cout << " Nano 3 : FD = " << FD3 << "  FL = " << FL3 << endl;
cout << "-----------------------------------------------------" << endl;
cout << " Total  : FD = " << FDtot << "  FL = " << FLtot << endl;
cout << "=====================================================" << endl;
cout << "||div(u)||_L2 = " << sqrt(int2d(Th)((dx(ux)+dy(uy))^2)) << endl;

// ----- Post-traitement fluide -----
plot(p,     value=true, wait=false, cmm="Pression p",          ps="F_pressure.eps");
plot([ux,uy],value=true,wait=false, cmm="Champ de vitesse",    ps="F_velocity.eps");
plot(p,[ux,uy],value=true,wait=false,cmm="Stokes - Nano6",     ps="F_combined.eps");

// Contraintes de Cauchy fluide (pour VTK)
fespace Wh(Th,P1dc);
Wh sxxFfl = -p + 2.*nu*dx(ux);
Wh syyFfl = -p + 2.*nu*dy(uy);
Wh sxyFfl =       nu*(dy(ux)+dx(uy));
Wh vmFluid  = sqrt(sxxFfl^2+syyFfl^2-sxxFfl*syyFfl+3.*sxyFfl^2);
cout << "vonMises fluide max = " << vmFluid[].max << endl;

// =========================================================================
// EXPORT VTK FLUIDE
// =========================================================================
{
    fespace Rh(Th,P1dc);
    Rh Xdes=x, Ydes=y, Zdes=0;
    Rh velxdes=ux, velydes=uy;
    Rh speeddes=sqrt(ux*ux+uy*uy);
    Rh presdes=p, vmFdes=vmFluid;
    int id;

    // Maillage fluide
    {
        ofstream fmsh("Maillage."+Name+".vtk");
        fmsh << "# vtk DataFile Version 1.0" << endl;
        fmsh << "Fluid Mesh Nano6" << endl;
        fmsh << "ASCII" << endl << " " << endl;
        fmsh << "DATASET UNSTRUCTURED_GRID" << endl;
        fmsh << "POINTS " << Rh.ndof << " float" << endl;
        for(id=0; id<Rh.ndof; id++)
            fmsh << Xdes[][id] << " " << Ydes[][id] << " 0" << endl;
        fmsh << "CELLS " << Rh.nt << " " << (Rh.ndofK+1)*Rh.nt << endl;
        for(id=0; id<Rh.nt; id++)
            fmsh << "3 " << Rh(id,0) << " " << Rh(id,1) << " " << Rh(id,2) << endl;
        fmsh << " " << endl << "CELL_TYPES " << Rh.nt << endl;
        for(id=0; id<Rh.nt; id++) fmsh << "5" << endl;
    }

    // Résultats fluide
    {
        ofstream fres("ResultsFluid"+Name+".vtk");
        fres << "# vtk DataFile Version 1.0" << endl;
        fres << "Fluid Results Stokes Nano6" << endl;
        fres << "ASCII" << endl << " " << endl;
        fres << "DATASET UNSTRUCTURED_GRID" << endl;
        fres << "POINTS " << Rh.ndof << " float" << endl;
        for(id=0; id<Rh.ndof; id++)
            fres << Xdes[][id] << " " << Ydes[][id] << " 0" << endl;
        fres << "CELLS " << Rh.nt << " " << (Rh.ndofK+1)*Rh.nt << endl;
        for(id=0; id<Rh.nt; id++)
            fres << "3 " << Rh(id,0) << " " << Rh(id,1) << " " << Rh(id,2) << endl;
        fres << " " << endl << "CELL_TYPES " << Rh.nt << endl;
        for(id=0; id<Rh.nt; id++) fres << "5" << endl;
        fres << " " << endl << "POINT_DATA " << Rh.ndof << endl;
        fres << "VECTORS velocity float" << endl;
        for(id=0; id<Rh.ndof; id++)
            fres << velxdes[][id] << " " << velydes[][id] << " 0" << endl;
        fres << "SCALARS speed float" << endl << "LOOKUP_TABLE default" << endl;
        for(id=0; id<Rh.ndof; id++) fres << speeddes[][id] << endl;
        fres << "SCALARS pressure float" << endl << "LOOKUP_TABLE default" << endl;
        for(id=0; id<Rh.ndof; id++) fres << presdes[][id] << endl;
        fres << "SCALARS vonMises_fluid float" << endl << "LOOKUP_TABLE default" << endl;
        for(id=0; id<Rh.ndof; id++) fres << vmFdes[][id] << endl;
    }
}
cout << "VTK fluide genere." << endl;

// =========================================================================
// PARTIE II — PROBLÈME SOLIDE NON LINÉAIRE (nanoparticule 2, centrale)
//
// Domaine : Ωs = demi-ellipse de demi-axes (aS, dS) centrée en (xC2, yC2)
// Frontières :
//   label 10 = Γ_f (base plate, interface particule/substrat TiO2)
//              → Lennard-Jones + frottement de Coulomb
//   label 11 = Γ_N (demi-ellipse, surface fluide)
//              → traction fluide T_fluide + Lennard-Jones
//
// Convention normales :
//   label 11 : normale extérieure = n_ellip (vers l'extérieur de la demi-ellipse)
//   label 10 : normale extérieure = (0,-1)  (vers le bas, i.e. vers le substrat)
//              => u_n = u·n = −u2,  gap = d0 + u2  (>0 si pas de pénétration)
//
// Formulation variationnelle conforme (éq. 27) :
//   Trouver u ∈ V tel que ∀v ∈ V :
//   ∫_Ωs σ(u):ε(v) dx
//   = ∫_ΓN T_fluide·v ds
//   + ∫_ΓN F_adh(d(u)) v_n ds          (LJ sur surface fluide)
//   + ∫_Γf F_adh(d(u)) v_n ds          (LJ sur base)
//   + ∫_Γf F_frot(u) · v_t ds          (Coulomb régularisé sur base)
//
// Schéma de Newton : a(δu,v) + J_LJ(δu,v) + J_Coul(δu,v) = −R(u^k)[v]
// =========================================================================

// ----- Géométrie du solide -----
real xC2 = xI + a;   // centre de la nano 2 (abscisse)
real yC2 = yL;       // base de la nano 2 (ordonnée = paroi substrat)
real aS  = a;        // demi-axe horizontal
real dS  = d;        // demi-axe vertical

// ----- Maillage solide -----
int nEllip = 60;   // points sur la demi-ellipse (Γ_N)
int nBase  = 30;   // points sur la base (Γ_f)

// Γ_f : base de gauche à droite (orientation pour normale extérieure vers le bas)
border Bbase(t=0,1){ x=(xC2+aS)+t*((xC2-aS)-(xC2+aS)); y=yC2; label=10; }
// Γ_N : demi-ellipse de 0 à π
border Bellip(t=0,pi){ x=xC2+aS*cos(t); y=yC2+dS*sin(t); label=11; }

mesh ThS = buildmesh(Bbase(-nBase)+Bellip(nEllip));
plot(ThS, wait=false, cmm="Maillage solide initial", ps="S_mesh_initial.eps");

// Raffinement adaptatif : plus fin près de la base (concentrations de contraintes)
fespace VhSi(ThS,P2);
VhSi distSol = (y-yC2)/dS;   // 0 sur la base, 1 au sommet
real hminS = 0.3*dS/nEllip,  hmaxS = 8.*hminS;
VhSi SmeshS = hmaxS*distSol + hminS*(1.-distSol);
mesh ThSA = adaptmesh(ThS, SmeshS, hmin=hminS, hmax=hmaxS,
                      IsMetric=1, err=0.01, nbvx=50000);
plot(ThSA, wait=false, cmm="Maillage solide raffine", ps="S_mesh_refined.eps");
cout << "Maillage solide : " << ThSA.nt << " triangles" << endl;

// =========================================================================
// PARAMÈTRES MATÉRIAU — Argent (Ag), adimensionnes (Pc=1 MPa, Lc=1 nm)
// E_Ag ~ 83 GPa  =>  E* = E/Pc = 83 000
// ν_Ag ~ 0.37
// =========================================================================
real Enano  = 83000.;   // module de Young adimensionné
real nunano = 0.37;     // coefficient de Poisson
real lam    = Enano*nunano/((1.+nunano)*(1.-2.*nunano));  // constante de Lamé λ
real muu    = Enano/(2.*(1.+nunano));                     // constante de Lamé μ
cout << "Ag : lambda = " << lam << "  mu = " << muu << endl;

// =========================================================================
// PARAMÈTRES LENNARD-JONES (éq. 16-17 du rapport)
// ϕ(d) = ε_LJ [ (d0/d)^12 − 2(d0/d)^6 ]
// F_adh(d) = (12 ε_LJ / d0) [ (d0/d)^13 − (d0/d)^7 ]
// =========================================================================
real epsLJ = 1.e-3;   // énergie d'adhésion adimensionnée
real d0    = 0.5;     // distance d'équilibre adimensionnée (< dS, zone mixte)

// =========================================================================
// PARAMÈTRE DE FROTTEMENT DE COULOMB (éq. 19 du rapport)
// F_frot = −C_f [σ_n]_− u_t / |u_t|  sur Γ_f  si |u_t| > 0
// =========================================================================
real muFric = 0.3;      // coefficient de frottement Ag/TiO2
real epsReg = 1.e-8;    // régularisation de |u_t| (évite division par 0)

// =========================================================================
// MACROS ÉLASTICITÉ
// =========================================================================
// Tenseur des déformations ε(u):ε(v) = ∂_x u1 ∂_x v1 + ∂_y u2 ∂_y v2
//                                      + ½(∂_y u1 + ∂_x u2)(∂_y v1 + ∂_x v2)
macro Epsilons(u1,u2,v1,v2)
    ( dx(u1)*dx(v1) + dy(u2)*dy(v2)
    + 0.5*(dy(u1)+dx(u2))*(dy(v1)+dx(v2)) ) // EOM

// Forme bilinéaire élastique a(u,v) = ∫ [λ div(u)div(v) + 2μ ε(u):ε(v)]
macro Abilin(u1,u2,v1,v2)
    ( lam*(dx(u1)+dy(u2))*(dx(v1)+dy(v2)) + 2.*muu*Epsilons(u1,u2,v1,v2) ) // EOM

// =========================================================================
// MACROS LENNARD-JONES
// Sur Γ_f (label 10) : normale extérieure = (0,-1)
//   u_n = u·n = u2·N.y = −u2  (car N.y = −1)
//   gap  d(u) = d0 − u_n = d0 + u2   (> 0 si pas de pénétration)
//
// Sur Γ_N (label 11) : u_n = u·n = u1·N.x + u2·N.y (normale extérieure sortante)
//   gap sur Γ_N : distance au substrat = yC2 + u2 (approximation d = d0 + u2)
//   On utilise la même macro hgap par cohérence (gap en u2)
// =========================================================================
macro hgap(u2)  max(d0 + u2, 1.e-12)                              // EOM
macro FLJf(u2)  (12.*epsLJ/d0)*( (d0/hgap(u2))^13-(d0/hgap(u2))^7 ) // EOM
// Rigidité tangente LJ : κ(d) = −dF/dd = d²ϕ/dd²
macro kLJf(u2)  (12.*epsLJ/(d0*d0))*(13.*(d0/hgap(u2))^14 - 7.*(d0/hgap(u2))^8) // EOM

// =========================================================================
// MACROS FROTTEMENT DE COULOMB (régularisé)
// On utilise F_LJ comme proxy pour la pression normale σ_n sur Γ_f :
//   [σ_n]_− = partie négative de F_LJ (i.e. quand F_LJ < 0 = attraction)
// Cette convention est cohérente avec la formulation du rapport (éq. 19) :
//   le frottement est actif uniquement en contact (F_LJ > 0, répulsion)
// => [F_LJ]_+ = max(F_LJ, 0)  (partie répulsive = compression)
// =========================================================================
macro FLJpos(u2) max(FLJf(u2), 0.)                                 // EOM
macro Ffrot(u1,u2)  (-muFric*FLJpos(u2)*u1/sqrt(u1*u1+epsReg*epsReg)) // EOM
// Jacobien du frottement : dF_frot/du1
macro dFfrot(u1,u2) (-muFric*FLJpos(u2)*epsReg*epsReg/pow(u1*u1+epsReg*epsReg,1.5)) // EOM

// =========================================================================
// INTERPOLATION DE LA TRACTION FLUIDE SUR LE MAILLAGE SOLIDE
// T_fluide = σ_fluide · n  avec  σ_fluide = −p I + 2η D(u)
// Composantes : Sxx = −p + 2ν ∂_x u,  Syy = −p + 2ν ∂_y v,  Sxy = ν(∂_y u + ∂_x v)
// =========================================================================
fespace WsP1(ThSA, P1dc);
WsP1 SxxF, SyyF, SxyF;
// Interpolation depuis le maillage fluide Th vers le maillage solide ThSA
SxxF = -p(x,y) + 2.*nu*dx(ux)(x,y);
SyyF = -p(x,y) + 2.*nu*dy(uy)(x,y);
SxyF =  nu*(dy(ux)(x,y) + dx(uy)(x,y));

// Vérification : forces transmises au solide (doivent coïncider avec FD2, FL2)
cout << "Traction fluide transmise (label 11) :" << endl;
cout << "  FT_x = " << int1d(ThSA,11)((SxxF*N.x+SxyF*N.y)) << endl;
cout << "  FT_y = " << int1d(ThSA,11)((SxyF*N.x+SyyF*N.y)) << endl;

// =========================================================================
// BOUCLE DE NEWTON
//
// Système tangent à chaque itération k (éq. 31 du rapport) :
//   Trouver δu ∈ Vh tel que ∀v ∈ Vh :
//   a(δu, v)                              [rigidité élastique]
//   − ∫_Γf κ(u^k) δu_n v_n ds            [rigidité tangente LJ sur Γ_f]
//   − ∫_ΓN κ(u^k) δu_n v_n ds            [rigidité tangente LJ sur Γ_N]
//   + ∫_Γf (dF_frot/du1)(u^k) δu1 v1 ds  [rigidité tangente Coulomb]
//   = −R(u^k)[v]
//
// Résidu R(u^k)[v] :
//   a(u^k, v)
//   − ∫_ΓN T_fluide · v ds
//   − ∫_ΓN F_LJ(u^k) v_n ds
//   − ∫_Γf F_LJ(u^k) v_n ds
//   − ∫_Γf F_frot(u^k) · v_t ds
//
// NOTE : pas de condition de Dirichlet (particule libre, tenue par LJ)
//        une pénalisation masse très faible (α << μ) élimine les modes rigides
//        sans perturber la solution physique.
// =========================================================================
fespace Ws(ThSA, P2);
Ws Dux=0., Duy=0., uSx, uSy, v1, v2;

// Pénalisation anti-modes-rigides (α = 10^-3 * μ << μ)
//real penRB = 1.e-3*muu;

int   NmaxNewton = 50;
real  tolerence  = 1.e-9;
//real  omega      = 1.0;   // pas de Newton (line-search fixe)

cout << "=====================================================" << endl;
cout << " Boucle de Newton (solide)" << endl;
cout << "-----------------------------------------------------" << endl;

for(int Nw=0; Nw<NmaxNewton; Nw++){

    problem NewtonStep([uSx,uSy],[v1,v2], solver=UMFPACK) =

        // ---- JACOBIEN ----
        // (1) Rigidité élastique : a(δu, v)
        int2d(ThSA)( Abilin(uSx,uSy,v1,v2) )

        // (2) Rigidité tangente LJ sur Γ_f (label 10), n=(0,-1) => v_n = -v2, δu_n = -δu2
        //     Terme : −∫_Γf κ(d(u^k)) δu_n v_n ds = −∫_Γf κ (−δu2)(−v2) ds
        //           = −∫_Γf κ δu2 v2 ds
        - int1d(ThSA,10)( kLJf(Duy)*uSy*v2 )

        // (3) Rigidité tangente LJ sur Γ_N (label 11) : v_n = N.y*v2+N.x*v1, δu_n pareil
        //     On utilise u2 comme variable de gap (approximation : gap ~ d0+u2 partout)
        //     Pour Γ_N : δu_n = δu2*N.y + δu1*N.x ≈ δu2*N.y (N.x ~ 0 en sommet)
        //     Forme générale : −∫_ΓN κ (δu·N)(v·N) ds
        - int1d(ThSA,11)( kLJf(Duy)*(uSx*N.x+uSy*N.y)*(v1*N.x+v2*N.y) )

        // (4) Rigidité tangente Coulomb sur Γ_f (label 10) : t = (1,0) sur la base
        //     d(F_frot)/d(u1) · δu1 · v1
        + int1d(ThSA,10)( dFfrot(Dux,Duy)*uSx*v1 )

        // (5) Pénalisation anti-modes-rigides
        + int2d(ThSA)( (uSx*v1+uSy*v2) )//penRB*

        // ---- RÉSIDU (membre de droite = −R(u^k)[v]) ----
        // (6) Résidu élastique : +a(u^k, v)
        + int2d(ThSA)( Abilin(Dux,Duy,v1,v2) )

        // (7) Moins traction fluide sur Γ_N : −∫_ΓN T_fluide · v ds
        - int1d(ThSA,11)( (SxxF*N.x+SxyF*N.y)*v1 + (SxyF*N.x+SyyF*N.y)*v2 )

        // (8) Moins force LJ sur Γ_N : −∫_ΓN F_adh(d(u^k)) v_n ds
        //     v_n = v·N = v1*N.x + v2*N.y
        - int1d(ThSA,11)( FLJf(Duy)*(v1*N.x+v2*N.y) )

        // (9) Moins force LJ sur Γ_f : −∫_Γf F_adh(d(u^k)) v_n ds
        //     Sur label 10 : n=(0,-1) => v_n = −v2
        //     => −∫_Γf F_LJ (−v2) ds = +∫_Γf F_LJ v2 ds
        //     En termes de résidu (−R) : on veut mettre F_LJ v2 du côté du membre de droite
        //     Écriture dans FreeFEM : − int1d(10)( F_LJ * v2 )
        //     (le − global vient du signe de la formule Green : voir dérivation du rapport)
        - int1d(ThSA,10)( FLJf(Duy)*v2 )

        // (10) Moins frottement sur Γ_f : −∫_Γf F_frot(u^k) v_t ds
        //      Sur label 10 : t = (1,0) => v_t = v1
        - int1d(ThSA,10)( Ffrot(Dux,Duy)*v1 )

        // (11) Résidu pénalisation
        + int2d(ThSA)( (Dux*v1+Duy*v2) );//penRB*
        

    NewtonStep;

    // Mise à jour avec pas omega
    Dux = Dux + uSx;
    Duy = Duy + uSy;

    // Critère de convergence : norme L2 de l'incrément
    real error = sqrt( int2d(ThSA)(uSx^2+uSy^2) / int2d(ThSA)(1.) );
    cout << " Newton it=" << Nw << "  ||du|| = " << error << endl;

    if(error < tolerence){
        cout << "Convergence atteinte en " << Nw+1 << " iterations." << endl;
        break;
    }
}

Ws u1 = Dux;
Ws u2 = Duy;

// =========================================================================
// POST-TRAITEMENT SOLIDE
// =========================================================================
fespace PhS(ThSA, P1);
PhS s11, s22, s12, vmSolid;
s11 = lam*(dx(u1)+dy(u2)) + 2.*muu*dx(u1);  // σ_11
s22 = lam*(dx(u1)+dy(u2)) + 2.*muu*dy(u2);  // σ_22
s12 = muu*(dy(u1)+dx(u2));                   // σ_12

// Contrainte équivalente de von Mises (éq. 32 du rapport)
vmSolid = sqrt(s11^2 - s11*s22 + s22^2 + 3.*s12^2);

cout << "=====================================================" << endl;
cout << " Resultats solide (adimensionnes)" << endl;
cout << "-----------------------------------------------------" << endl;
cout << " ||u||_inf      = " << sqrt(u1[].linfty^2+u2[].linfty^2) << endl;
cout << " sigma_VM max   = " << vmSolid[].max << endl;
cout << "=====================================================" << endl;

// Bilan des forces sur la particule
cout << "Forces sur la particule (solide) :" << endl;
cout << "  F_fluide_x = " << int1d(ThSA,11)((SxxF*N.x+SxyF*N.y)) << endl;
cout << "  F_fluide_y = " << int1d(ThSA,11)((SxyF*N.x+SyyF*N.y)) << endl;
cout << "  F_LJ_y (Gf)= " << int1d(ThSA,10)(FLJf(u2)) << endl;
cout << "  F_frot_x   = " << int1d(ThSA,10)(Ffrot(u1,u2)) << endl;

// Glissement tangentiel et gap residuel
PhS glissement = u1;                       // u_t = u1 sur la base (t=(1,0))
PhS deplNorm   = sqrt(u1^2+u2^2);
PhS gapFinal;
gapFinal = hgap(u2);                       // distance gap après déformation

// Maillage déformé (facteur d'amplification automatique)
real scaleP = min(0.20*dS/(u1[].linfty+u2[].linfty+1.e-30), 1.e4);
cout << "Facteur amplification maillage deforme : x" << scaleP << endl;
mesh ThSdef = movemesh(ThSA, [x+scaleP*u1, y+scaleP*u2]);

// Visualisation FreeFEM++
plot(ThSA, [u1,u2],  value=true, wait=false,
     cmm="Deplacement particule",      ps="S_displacement.eps");
plot(ThSA, vmSolid,  value=true, wait=false,
     cmm="Contrainte von Mises",       ps="S_vonMises.eps");
plot(ThSdef,         wait=false,
     cmm="Maillage deforme (x"+scaleP+")", ps="S_deformed.eps");

// =========================================================================
// EXPORT VTK SOLIDE
// =========================================================================
{
    fespace RhS(ThSA,P1dc);
    RhS XdesS=x, YdesS=y, ZdesS=0;
    RhS u1des=u1, u2des=u2, vmdes=vmSolid;
    RhS s11des=s11, s22des=s22, s12des=s12;
    RhS glisdes=glissement, depldes=deplNorm, gapdes=gapFinal;
    int id;

    // Solide sur maillage de référence
    {
        ofstream fvtk("ResultsSolid"+Name+".vtk");
        fvtk << "# vtk DataFile Version 1.0" << endl;
        fvtk << "Solid Nanoparticle FSI - Nano6" << endl;
        fvtk << "ASCII" << endl << " " << endl;
        fvtk << "DATASET UNSTRUCTURED_GRID" << endl;
        fvtk << "POINTS " << RhS.ndof << " float" << endl;
        for(id=0; id<RhS.ndof; id++)
            fvtk << XdesS[][id] << " " << YdesS[][id] << " 0" << endl;
        fvtk << "CELLS " << RhS.nt << " " << (RhS.ndofK+1)*RhS.nt << endl;
        for(id=0; id<RhS.nt; id++)
            fvtk << "3 " << RhS(id,0) << " " << RhS(id,1) << " " << RhS(id,2) << endl;
        fvtk << " " << endl << "CELL_TYPES " << RhS.nt << endl;
        for(id=0; id<RhS.nt; id++) fvtk << "5" << endl;

        fvtk << " " << endl << "POINT_DATA " << RhS.ndof << endl;

        fvtk << "VECTORS displacement float" << endl;
        for(id=0; id<RhS.ndof; id++)
            fvtk << u1des[][id] << " " << u2des[][id] << " 0" << endl;

        fvtk << "SCALARS displacement_norm float" << endl << "LOOKUP_TABLE default" << endl;
        for(id=0; id<RhS.ndof; id++) fvtk << depldes[][id] << endl;

        fvtk << "SCALARS vonMises_solid float" << endl << "LOOKUP_TABLE default" << endl;
        for(id=0; id<RhS.ndof; id++) fvtk << vmdes[][id] << endl;

        fvtk << "SCALARS sigma11 float" << endl << "LOOKUP_TABLE default" << endl;
        for(id=0; id<RhS.ndof; id++) fvtk << s11des[][id] << endl;

        fvtk << "SCALARS sigma22 float" << endl << "LOOKUP_TABLE default" << endl;
        for(id=0; id<RhS.ndof; id++) fvtk << s22des[][id] << endl;

        fvtk << "SCALARS sigma12 float" << endl << "LOOKUP_TABLE default" << endl;
        for(id=0; id<RhS.ndof; id++) fvtk << s12des[][id] << endl;

        fvtk << "SCALARS slip_tangential float" << endl << "LOOKUP_TABLE default" << endl;
        for(id=0; id<RhS.ndof; id++) fvtk << glisdes[][id] << endl;

        fvtk << "SCALARS gap_LJ float" << endl << "LOOKUP_TABLE default" << endl;
        for(id=0; id<RhS.ndof; id++) fvtk << gapdes[][id] << endl;
    }

    // Solide sur maillage déformé
    {
        fespace RhSD(ThSA,P1dc);
        RhSD XdesSD=x+u1, YdesSD=y+u2;
        RhSD u1D=u1, u2D=u2, vmD=vmSolid;
        RhSD s11D=s11, s22D=s22, s12D=s12;
        RhSD glisD=glissement, deplD=deplNorm, gapD=gapFinal;

        ofstream fvtkD("ResultsSolidDeformed"+Name+".vtk");
        fvtkD << "# vtk DataFile Version 1.0" << endl;
        fvtkD << "Solid Nanoparticle DEFORMED - Nano6" << endl;
        fvtkD << "ASCII" << endl << " " << endl;
        fvtkD << "DATASET UNSTRUCTURED_GRID" << endl;
        fvtkD << "POINTS " << RhSD.ndof << " float" << endl;
        for(id=0; id<RhSD.ndof; id++)
            fvtkD << XdesSD[][id] << " " << YdesSD[][id] << " 0" << endl;
        fvtkD << "CELLS " << RhSD.nt << " " << (RhSD.ndofK+1)*RhSD.nt << endl;
        for(id=0; id<RhSD.nt; id++)
            fvtkD << "3 " << RhSD(id,0) << " " << RhSD(id,1) << " " << RhSD(id,2) << endl;
        fvtkD << " " << endl << "CELL_TYPES " << RhSD.nt << endl;
        for(id=0; id<RhSD.nt; id++) fvtkD << "5" << endl;

        fvtkD << " " << endl << "POINT_DATA " << RhSD.ndof << endl;

        fvtkD << "VECTORS displacement float" << endl;
        for(id=0; id<RhSD.ndof; id++)
            fvtkD << u1D[][id] << " " << u2D[][id] << " 0" << endl;

        fvtkD << "SCALARS displacement_norm float" << endl << "LOOKUP_TABLE default" << endl;
        for(id=0; id<RhSD.ndof; id++) fvtkD << deplD[][id] << endl;

        fvtkD << "SCALARS vonMises_solid float" << endl << "LOOKUP_TABLE default" << endl;
        for(id=0; id<RhSD.ndof; id++) fvtkD << vmD[][id] << endl;

        fvtkD << "SCALARS sigma11 float" << endl << "LOOKUP_TABLE default" << endl;
        for(id=0; id<RhSD.ndof; id++) fvtkD << s11D[][id] << endl;
        fvtkD << "SCALARS sigma22 float" << endl << "LOOKUP_TABLE default" << endl;
        for(id=0; id<RhSD.ndof; id++) fvtkD << s22D[][id] << endl;
        fvtkD << "SCALARS sigma12 float" << endl << "LOOKUP_TABLE default" << endl;
        for(id=0; id<RhSD.ndof; id++) fvtkD << s12D[][id] << endl;

        fvtkD << "SCALARS slip_tangential float" << endl << "LOOKUP_TABLE default" << endl;
        for(id=0; id<RhSD.ndof; id++) fvtkD << glisD[][id] << endl;

        fvtkD << "SCALARS gap_LJ float" << endl << "LOOKUP_TABLE default" << endl;
        for(id=0; id<RhSD.ndof; id++) fvtkD << gapD[][id] << endl;
    }
}

// =========================================================================
// RÉSUMÉ FINAL
// =========================================================================
cout << endl;
cout << "=====================================================" << endl;
cout << " Fichiers VTK generes :" << endl;
cout << "  Maillage."               << Name << ".vtk" << endl;
cout << "  ResultsFluid"            << Name << ".vtk" << endl;
cout << "  ResultsSolid"            << Name << ".vtk" << endl;
cout << "  ResultsSolidDeformed"    << Name << ".vtk" << endl;
cout << "-----------------------------------------------------" << endl;
cout << " Scalaires solide disponibles (ParaView) :" << endl;
cout << "   displacement_norm  : norme deplacement" << endl;
cout << "   vonMises_solid     : contrainte equiv. von Mises" << endl;
cout << "   sigma11/22/12      : composantes tenseur Cauchy" << endl;
cout << "   slip_tangential    : glissement u1 sur Gamma_f" << endl;
cout << "   gap_LJ             : gap residuel d(u) = d0 + u2" << endl;
cout << "=====================================================" << endl;
